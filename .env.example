# Copia este archivo a .env.local (no se sube a git) y llena los valores para
# activar el diálogo con el agrónomo virtual y el diagnóstico por foto.
# Sin estas variables, la app funciona igual mostrando el diagnóstico por reglas
# ya existente, pero el asistente de IA queda desactivado (aviso claro en pantalla).
#
# EXPO_PUBLIC_* se embebe en el bundle de la app: no pongas aquí la API key real
# de Anthropic, esa vive solo en el backend (ver server/README.md).

# URL del backend desplegado (ver server/README.md para desplegarlo en Vercel).
EXPO_PUBLIC_AGRONOMIST_API_URL=https://tu-backend.vercel.app

# Debe coincidir exactamente con APP_SHARED_SECRET configurado en el backend.
EXPO_PUBLIC_AGRONOMIST_APP_KEY=

# Opcional: enlace de pago oficial de Mercado Pago (link de pago creado en tu cuenta de
# Mercado Pago). Si existe, la pantalla "Pagos y facturación" muestra el botón
# "Pagar con Mercado Pago"; si no, solo ofrece solicitar el enlace por WhatsApp.
EXPO_PUBLIC_MERCADOPAGO_LINK=
