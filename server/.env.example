# Copia este archivo a .env.local para desarrollo local (no lo subas a git).
# En Vercel, configura estas mismas variables en Project Settings → Environment Variables.

# API key de Anthropic (https://console.anthropic.com/settings/keys). NUNCA la pongas
# en la app móvil ni en un repo público: solo vive aquí, en el servidor.
ANTHROPIC_API_KEY=

# Secreto compartido que la app móvil manda en el header X-Chaman-App-Key. Genera un
# valor largo y aleatorio (ej. openssl rand -hex 32). Ver lib/auth.ts para el porqué
# de este mecanismo y sus límites.
APP_SHARED_SECRET=

# --- Canal de WhatsApp del agente de ventas (POST/GET /api/whatsapp-webhook) ---
# Sin estas variables, ese endpoint queda inactivo, pero /api/chat y /api/sales-chat
# siguen funcionando igual. Ver server/README.md para la guía completa de conexión.

# Token de acceso de la app de WhatsApp Business en Meta for Developers (idealmente
# un token permanente de un usuario de sistema, no el temporal de 24h de prueba).
WHATSAPP_ACCESS_TOKEN=

# El "Phone Number ID" que Meta asigna al número de WhatsApp Business (NO es el
# número de teléfono en sí: es un ID numérico que ves en el panel de WhatsApp > API
# Setup, junto al número).
WHATSAPP_PHONE_NUMBER_ID=

# String que tú inventas (ej. openssl rand -hex 16) y pegas también en el campo
# "Verify token" al configurar el webhook en Meta for Developers.
WHATSAPP_VERIFY_TOKEN=

# App Secret de la app de Meta (Configuración básica de la app). Opcional pero
# recomendado: si se configura, cada webhook entrante se valida por firma HMAC
# (ver lib/whatsapp.ts); si se deja vacío, no se valida la firma.
WHATSAPP_APP_SECRET=

# --- Historial de conversación de WhatsApp (Vercel Storage → Redis, vía Upstash) ---
# El webhook de WhatsApp no tiene ninguna app/SQLite detrás que guarde el historial
# como sí pasa en /api/chat y /api/sales-chat, así que este servidor necesita su
# propia base de datos para no olvidar la conversación en cada mensaje. Al conectar
# una base de datos Redis al proyecto en Vercel, estas variables se inyectan solas
# (no hace falta llenarlas a mano si usas esa integración).
KV_REST_API_URL=
KV_REST_API_TOKEN=
