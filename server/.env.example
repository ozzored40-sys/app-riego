# Copia este archivo a .env.local para desarrollo local (no lo subas a git).
# En Vercel, configura estas mismas variables en Project Settings → Environment Variables.

# API key de Anthropic (https://console.anthropic.com/settings/keys). NUNCA la pongas
# en la app móvil ni en un repo público: solo vive aquí, en el servidor.
ANTHROPIC_API_KEY=

# Secreto compartido que la app móvil manda en el header X-Chaman-App-Key. Genera un
# valor largo y aleatorio (ej. openssl rand -hex 32). Ver lib/auth.ts para el porqué
# de este mecanismo y sus límites.
APP_SHARED_SECRET=
