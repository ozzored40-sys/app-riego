# Copia este archivo a .env.local para desarrollo local (no lo subas a git).
# En Vercel, configura estas mismas variables en Project Settings → Environment Variables.

# API key de Anthropic (https://console.anthropic.com/settings/keys). NUNCA la pongas
# en la app móvil ni en un repo público: solo vive aquí, en el servidor.
ANTHROPIC_API_KEY=

# Secreto compartido que la app móvil manda en el header X-Chaman-App-Key. Genera un
# valor largo y aleatorio (ej. openssl rand -hex 32). Ver lib/auth.ts para el porqué
# de este mecanismo y sus límites.
APP_SHARED_SECRET=

# --- Agente de WhatsApp (ver README.md → "Agente de WhatsApp") ---

# Access token permanente de la app de Meta for Developers (WhatsApp > Configuración de la API).
WHATSAPP_ACCESS_TOKEN=

# Phone Number ID (NO es el número de teléfono) del número de WhatsApp Business, visible en
# Meta for Developers → WhatsApp → Introducción a la API.
WHATSAPP_PHONE_NUMBER_ID=

# Cualquier cadena que tú inventes; se usa para verificar el webhook al configurarlo en Meta
# (debe coincidir exactamente con lo que pongas ahí).
WHATSAPP_VERIFY_TOKEN=

# App Secret de la app de Meta (Configuración básica de la app). Se usa para validar la firma
# de cada solicitud del webhook y así confirmar que viene realmente de WhatsApp.
WHATSAPP_APP_SECRET=

# Número de WhatsApp del vendedor/dueño (con código de país, sin '+', ej. 5219991234567) al
# que se le avisa cuando el bot cierra un pedido. Ver lib/notify.ts sobre la ventana de 24 h.
OWNER_WHATSAPP_NUMBER=

# Base de datos Redis de Upstash (https://upstash.com, capa gratuita alcanza sin problema) —
# guarda el historial de conversación de cada número de WhatsApp. Copia la REST URL y el REST
# Token del dashboard de tu base de datos.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
