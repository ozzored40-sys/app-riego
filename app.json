{
  "expo": {
    "name": "Chamán 4.0",
    "slug": "chaman-nutriflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chamannutriflow",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.ozonochaman.centrodecomando",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070b14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ozonochaman.centrodecomando"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070b14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Chamán 4.0 usa tu ubicación para obtener el clima del lote (ETo y lluvia) automáticamente."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Chamán 4.0 necesita acceso a tus fotos para que subas una imagen del cultivo al diagnóstico.",
          "cameraPermission": "Chamán 4.0 necesita la cámara para tomar una foto del cultivo y enviarla al diagnóstico."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Centro de Comando Chamán 4.0: diagnóstico de campo con dictamen, especialistas IA, CRM de productores, riego y nutrición.",
    "backgroundColor": "#070b14"
  }
}
