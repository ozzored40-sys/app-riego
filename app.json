{
  "expo": {
    "name": "Chamán NutriFlow",
    "slug": "chaman-nutriflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chamannutriflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Chamán NutriFlow usa tu ubicación para obtener el clima del lote (ETo y lluvia) automáticamente."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Chamán NutriFlow necesita acceso a tus fotos para que subas una imagen del cultivo al diagnóstico.",
          "cameraPermission": "Chamán NutriFlow necesita la cámara para tomar una foto del cultivo y enviarla al diagnóstico."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
